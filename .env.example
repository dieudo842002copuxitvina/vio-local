# ── Supabase ──────────────────────────────────────────────────────────────────
# All VITE_ vars are bundled into the client build — keep them to public keys only.

# Project URL — found in Supabase dashboard → Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable (anon) key — safe to expose in the browser
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Server-only (never use VITE_ prefix here) ─────────────────────────────────
# These are NOT bundled to the client. Used by createServerSupabaseClient() only.

# Mirrors VITE_SUPABASE_URL for server contexts that don't have import.meta.env
SUPABASE_URL=https://<project-ref>.supabase.co

# Secret (service role) key — grants full DB access, never expose to the browser
SUPABASE_SECRET_KEY=sb_secret_...
